# Signed bytes and keys: a checkout that rewrote their line endings (Git on
# Windows does, by default) would break every signature over them.
packaging/minisign.pub -text
tests/fixtures/update/** -text
# The skill init-claude writes is compared and written byte for byte; its
# frontmatter must start "---\n" wherever it was checked out.
src/skill/** text eol=lf
